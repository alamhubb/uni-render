{
    "name": "uniapp-vue-render",
    "version": "0.1.0",
    "description": "为 uni-app 小程序提供 Vue 3 渲染函数（h 函数）支持，使用自定义渲染器",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts",
        "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
    },
    "keywords": [
        "uniapp",
        "vue3",
        "render",
        "h-function",
        "custom-renderer",
        "miniprogram"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "uniapp-vue-adapter": "workspace:*"
    },
    "peerDependencies": {
        "vue": "^3.0.0"
    },
    "devDependencies": {
        "@vue/runtime-core": "^3.4.0",
        "@vue/shared": "^3.4.0",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0",
        "vue": "^3.4.0"
    }
}