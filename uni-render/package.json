{
  "name": "uni-render",
  "version": "0.0.1-alpha.2",
  "type": "module",
  "description": "让 UniApp 支持 Vue render 函数（h 函数）开发，兼容 H5 和微信小程序",
  "author": "alamhubb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlamHubb/uni-render.git",
    "directory": "uni-render"
  },
  "bugs": {
    "url": "https://github.com/AlamHubb/uni-render/issues"
  },
  "homepage": "https://github.com/AlamHubb/uni-render/tree/main/uni-render#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./src/components/*": "./src/components/*"
  },
  "files": [
    "dist",
    "src/components"
  ],
  "keywords": [
    "uni-app",
    "uniapp",
    "vue",
    "vue3",
    "h-function",
    "render",
    "render-function",
    "custom-renderer",
    "miniapp",
    "miniprogram",
    "weixin",
    "wechat",
    "h5"
  ],
  "scripts": {
    "build": "tsdown",
    "release": "npm publish --tag latest",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "vue": "~3.4.0",
    "@vue/runtime-dom": "~3.4.0",
    "@vue/runtime-core": "~3.4.0"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "@types/node": "^24.10.1",
    "tsdown": "0.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "@vue/runtime-core": "3.4.21",
    "@vue/runtime-dom": "3.4.21",
    "vue": "3.4.21"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}